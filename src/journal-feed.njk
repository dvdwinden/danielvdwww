---
permalink: /journal/feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
  <title>{{ metadata.title }} • Journal</title>
  <subtitle>{{ metadata.description }}</subtitle>
  <link href="{{ metadata.url }}/journal/feed.xml" rel="self"/>
  <link href="{{ metadata.url }}/journal/"/>
  <updated>{{ collections.journal | getNewestCollectionItemDate | dateToRfc3339 }}</updated>
  <id>{{ metadata.url }}/journal/</id>
  <author>
    <name>{{ metadata.author.name }}</name>
    <email>{{ metadata.author.email }}</email>
  </author>
  {%- for post in collections.journal.slice(0, 20) %}
  {%- set absolutePostUrl = post.url | absoluteUrl(metadata.url) %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{% if post.data.external_url %}{{ post.data.external_url | escape }}{% else %}{{ absolutePostUrl }}{% endif %}"/>
    <updated>{{ post.data.date | dateToRfc3339 }}</updated>
    <id>{{ absolutePostUrl }}</id>
    <content type="html">{% set contentWithoutTitle = post.templateContent | replace("<h1>" + post.data.title + "</h1>", "") | rssSafe %}{{ contentWithoutTitle | htmlToAbsoluteUrls(absolutePostUrl) }}{% if post.data.external_url %}&lt;p&gt;&lt;a href="{{ post.data.external_url | escape }}"&gt;Continue reading →&lt;/a&gt;&lt;/p&gt;{% endif %}&lt;hr&gt;&lt;p&gt;&lt;em&gt;Thank you for reading my RSS feed. If you’d like to respond, you can &lt;a href="mailto:d.vanderwinden@gmail.com"&gt;email me&lt;/a&gt; or seek me out on &lt;a href="https://bsky.app/profile/daniel.pizza"&gt;Bluesky&lt;/a&gt;.&lt;/em&gt;&lt;/p&gt;</content>
  </entry>
  {%- endfor %}
</feed>
