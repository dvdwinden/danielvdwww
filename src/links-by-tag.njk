---
pagination:
  data: collections.linkTagPages
  size: 1
  alias: tagPage
permalink: "links/{{ tagPage.slug }}/{% if tagPage.pageNumber > 0 %}page/{{ tagPage.pageNumber + 1 }}/{% endif %}index.html"
layout: narrow.njk
bodyClass: bg-green
eleventyComputed:
  title: "Links / {{ tagPage.name | capitalize }}"
  description: "All links tagged with {{ tagPage.name | capitalize }}"
  robots: "{% if tagPage.pageNumber > 0 %}noindex, follow{% endif %}"
  canonicalUrl: "/links/{{ tagPage.slug }}/"
---

<h1 class="links-title">Links<span class="links-title__divider"> / </span><span class="links-title__tag">{{ tagPage.name | capitalize }}</span></h1>

{% set start = tagPage.pageNumber * 10 + 1 %}
{% set end = start + tagPage.posts.length - 1 %}

<ul class="divide-y divide-gray-950/10 dark:divide-white/5 links">
  {% for post in tagPage.posts %}
  <li class="py-3 pl-0">
    <div class="flex flex-col">
      <div class="flex items-baseline justify-between">
        <a href="{{ post.data.external_url }}" class="text-2xl font-serif font-semibold hover:underline" target="_blank" rel="external">
         <h2 class="no-underline">{{ post.data.title }}</h2>
        </a>
        <span class="text-xs uppercase font-semibold tracking-widest text-gray-500 ml-4 whitespace-nowrap font-sans">
          {% set postIndex = collections.links.indexOf(post) %}
          № {{ collections.links.length - postIndex }}
        </span>
      </div>
      <div class="prose prose-sm mt-4 dark:text-gray-300">
        {{ post.templateContent | removeH1 | safe }}
      </div>
    </div>
  </li>
  {% endfor %}
</ul>

{% if tagPage.previousHref or tagPage.nextHref %}
<nav class="pagination flex items-center justify-between mt-8 pt-4 border-t border-gray-200 dark:border-gray-700">
  {% if tagPage.previousHref %}
    <a href="{{ tagPage.previousHref }}" class="text-sm font-medium text-gray-700 hover:text-hover dark:hover:text-gray-300" aria-label="Previous page" alt="Previous page">
      <span>{% include "icons/arrow-left-round.svg" %}</span>
    </a>
  {% else %}
    <span class="text-gray-300 dark:text-gray-500">{% include "icons/arrow-left-round.svg" %}</span>
  {% endif %}

  <span class="text-sm font-sans text-gray-500">
    Page {{ tagPage.pageNumber + 1 }} of {{ tagPage.totalPages }}
  </span>

  {% if tagPage.nextHref %}
    <a href="{{ tagPage.nextHref }}" class="text-gray-700 hover:text-hover dark:hover:text-gray-300" aria-label="Next page" alt="Next page">
      <span>{% include "icons/arrow-right-round.svg" %}</span>
    </a>
  {% else %}
    <span class="text-gray-300 dark:text-gray-500">{% include "icons/arrow-right-round.svg" %}</span>
  {% endif %}
</nav>
{% endif %}
