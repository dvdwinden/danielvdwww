<div class="photo-grid mt-16 lg:mt-32 pb-16">
  {% for photo in photos | photoPlacement %}
  <figure data-col="{{ photo.colStart }}" data-span="{{ photo.colSpan }}">
    <div class="photo-frame" data-orientation="{{ photo.orientation }}" role="img" aria-label="{{ photo.caption }}"></div>
    <figcaption class="font-sans tracking-wide">{{ photo.caption }}</figcaption>
  </figure>
  {% endfor %}
