<div class="w-full max-w-lg ml-auto prose prose-lg font-serif lg:pt-[25vh] pt-[6vh] dark:prose-invert">
  <h1>Photos</h1>
  <p>Taken with an Olympus AF-10 and an AF-10 Super, usually on Kodak Ultramax, and never edited.</p>
</div>

<div class="photo-grid mt-16 lg:mt-32 pb-16">
  {% for photo in photos | photoPlacement %}
  <figure data-col="{{ photo.colStart }}" data-span="{{ photo.colSpan }}" style="--photo-row: {{ photo.row }}">
    {% if photo.src %}
      <button type="button" class="photo-open"
              data-caption="{{ photo.caption }}"
              data-tint="{% photoTint photo.src %}"
              aria-label="Enlarge: {{ photo.alt or photo.caption }}">
        {# Wrapped in <picture> so the optimizeImages transform treats these as
           already processed. Without it they are classified as "breakout"
           images - their nearest max-width ancestor is the wide container -
           and re-emitted with BREAKOUT_SIZES, which advertises ~1400px for a
           photo that occupies about a third of that. Every photo then fetched
           its largest rendition. #}
        <picture>
          {% if photo.isLandscape %}
            {% image photo.src, photo.alt or photo.caption, "(min-width: 1024px) 56vw, 100vw" %}
          {% else %}
            {% image photo.src, photo.alt or photo.caption, "(min-width: 1024px) 28vw, 100vw" %}
          {% endif %}
        </picture>
      </button>
    {% else %}
      <div class="photo-frame" data-orientation="{{ photo.orientation }}" role="img" aria-label="{{ photo.alt or photo.caption }}"></div>
    {% endif %}
    <figcaption class="font-sans tracking-wide">{{ photo.caption }}</figcaption>
  </figure>
  {% endfor %}
</div>

<dialog id="photo-lightbox" aria-label="Enlarged photograph" tabindex="-1" autofocus>
  <div class="lightbox-nav lightbox-prev" aria-hidden="true"></div>
  <div class="lightbox-nav lightbox-next" aria-hidden="true"></div>
  <button type="button" class="lightbox-close" aria-label="Close">
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false">
      <path d="M5.5 5.5 L18.5 18.5 M18.5 5.5 L5.5 18.5"
            fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" />
    </svg>
  </button>
  <figure class="lightbox-figure">
    <img class="lightbox-image" alt="">
    <figcaption class="lightbox-caption font-sans tracking-wide" aria-live="polite"></figcaption>
  </figure>
</dialog>
