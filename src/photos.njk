<div class="w-full max-w-lg ml-auto prose prose-lg font-serif lg:pt-[25vh] pt-[6vh] dark:prose-invert">
  <h1>Photos</h1>
  <p>Photographs, mostly taken on foot.</p>
</div>

<div class="photo-grid mt-16 lg:mt-32 pb-16">
  {% for photo in photos | photoPlacement %}
  <figure data-col="{{ photo.colStart }}" data-span="{{ photo.colSpan }}">
    {% if photo.src %}
      {% if photo.isLandscape %}
        {% image photo.src, photo.caption, "(min-width: 1024px) 60vw, 100vw" %}
      {% else %}
        {% image photo.src, photo.caption, "(min-width: 1024px) 30vw, 100vw" %}
      {% endif %}
    {% else %}
      <div class="photo-frame" data-orientation="{{ photo.orientation }}" role="img" aria-label="{{ photo.caption }}"></div>
    {% endif %}
    <figcaption class="font-sans tracking-wide">{{ photo.caption }}</figcaption>
  </figure>
  {% endfor %}
</div>
