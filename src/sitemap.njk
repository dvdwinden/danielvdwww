---
permalink: sitemap.xml
eleventyExcludeFromCollections: true
templateEngineOverride: njk
---

<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
\n  {% set homePage = {
    "url": "/",
    "date": "2025-07-31",
    "changefreq": "daily",
    "priority": 1.0
  } %}
  {% set nowPage = {
    "url": "/now/",
    "date": "2025-07-31",
    "changefreq": "weekly",
    "priority": 0.8
  } %}
  {% set sections = ["journal", "links", "newsletter"] %}
  {% for section in sections %}
  {% set sectionPage = {
    "url": "/" + section + "/",
    "date": "2025-07-31",
    "changefreq": "weekly",
    "priority": 0.7
  } %}
  {% include "_includes/sitemap-entry.njk" with homePage %}
  {% include "_includes/sitemap-entry.njk" with nowPage %}
  {% include "_includes/sitemap-entry.njk" with sectionPage %}
  {% endfor %}

{% for page in collections.all %}
  {% if not page.data.draft and page.url %}
  <url>
    <loc>{{ metadata.url }}{{ page.url }}</loc>
    <lastmod>{{ page.date | date("yyyy-MM-dd") }}</lastmod>
    {% if page.url == "/" %}
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
    {% elif page.url == "/now/" %}
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
    {% elif "/journal/" in page.url and page.url != "/journal/" %}
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
    {% elif "/links/" in page.url and page.url != "/links/" %}
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
    {% elif "/newsletter/" in page.url and page.url != "/newsletter/" %}
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
    {% elif page.url == "/journal/" or page.url == "/links/" or page.url == "/newsletter/" %}
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
    {% else %}
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
    {% endif %}
  </url>
  {% endif %}
{% endfor %}
</urlset>

