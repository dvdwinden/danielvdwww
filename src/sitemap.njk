---
permalink: sitemap.xml
eleventyExcludeFromCollections: true
templateEngineOverride: njk
---

<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <!-- Homepage -->
  <url>
    <loc>{{ metadata.url }}/</loc>
    <lastmod>{{ "now" | date("yyyy-MM-dd") }}</lastmod>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  <!-- Main sections -->
  <url>
    <loc>{{ metadata.url }}/now/</loc>
    <lastmod>{{ "now" | date("yyyy-MM-dd") }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>{{ metadata.url }}/journal/</loc>
    <lastmod>{{ "now" | date("yyyy-MM-dd") }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>{{ metadata.url }}/links/</loc>
    <lastmod>{{ "now" | date("yyyy-MM-dd") }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>{{ metadata.url }}/newsletter/</loc>
    <lastmod>{{ "now" | date("yyyy-MM-dd") }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>

{% for page in collections.all %}
  {% if not page.data.draft and page.url %}
  <url>
    <loc>{{ metadata.url }}{{ page.url }}</loc>
    <lastmod>{{ page.date | date("yyyy-MM-dd") }}</lastmod>
    {% if page.url == "/" %}
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
    {% elif page.url == "/now/" %}
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
    {% elif "/journal/" in page.url and page.url != "/journal/" %}
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
    {% elif "/links/" in page.url and page.url != "/links/" %}
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
    {% elif "/newsletter/" in page.url and page.url != "/newsletter/" %}
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
    {% elif page.url == "/journal/" or page.url == "/links/" or page.url == "/newsletter/" %}
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
    {% else %}
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
    {% endif %}
  </url>
  {% endif %}
{% endfor %}
</urlset>

