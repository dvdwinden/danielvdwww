<!DOCTYPE html>
<html lang="en">
<head>
	<script>
	  // Apply dark mode immediately to prevent flash
	  if (localStorage.theme === 'dark' ||
	    (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
	    document.documentElement.classList.add('dark');
	  }
	  // Hide content until fonts are ready to prevent FOUT
	  document.documentElement.classList.add('fonts-loading');
	</script>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16x16.png">
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
    <title>{% if title %}
        {% if page.url == '/' %}
            Daniël van der Winden · Software designer & writer
        {% else %}
            {{ title }} · Daniël van der Winden
        {% endif %}
    {% else %}
        Daniël van der Winden · Software designer & writer
    {% endif %}</title>
    <meta name="description" content="{{ description or site.description }}">
    <link rel="canonical" href="{{ metadata.url }}{{ canonicalUrl or page.url }}">
    {% if draft %}
    <meta name="robots" content="noindex, nofollow">
    {% elif robots %}
    <meta name="robots" content="{{ robots }}">
    {% endif %}
    <!-- Pre-load font files -->
    <link rel="preload" href="/assets/fonts/Blanco-Regular.woff" as="font" type="font/woff" crossorigin>
    <link rel="preload" href="/assets/fonts/DegularVariable.woff2" as="font" type="font/woff2" crossorigin>

    <!-- Inline @font-face so browser discovers fonts before external CSS loads -->
    <style>
    .fonts-loading #page-content { opacity: 0; }
    @font-face {
        font-family: 'Blanco';
        src: url('/assets/fonts/Blanco-Regular.woff') format('woff');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
    }
    @font-face {
        font-family: 'Blanco';
        src: url('/assets/fonts/Blanco-Medium.woff') format('woff');
        font-weight: 500;
        font-style: normal;
        font-display: swap;
    }
    @font-face {
        font-family: 'Blanco';
        src: url('/assets/fonts/Blanco-Italic.woff2') format('woff2'),
            url('/assets/fonts/Blanco-Italic.woff') format('woff');
        font-weight: 400;
        font-style: italic;
        font-display: swap;
    }
    @font-face {
        font-family: 'Blanco';
        src: url('/assets/fonts/Blanco-MediumItalic.woff2') format('woff2'),
            url('/assets/fonts/Blanco-MediumItalic.woff') format('woff');
        font-weight: 500;
        font-style: italic;
        font-display: swap;
    }
    @font-face {
        font-family: 'Degular';
        src: url('/assets/fonts/DegularVariable.woff2') format('woff2-variations'),
            url('/assets/fonts/DegularVariable.woff2') format('woff2'),
            url('/assets/fonts/DegularVariable.ttf') format('truetype');
        font-weight: 100 900;
        font-style: normal;
        font-display: swap;
    }
    </style>

    <link rel="stylesheet" href="/css/style.css">

    <meta name="theme-color" content="#f5f7fa" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#222" media="(prefers-color-scheme: dark)">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="mobile-web-app-capable" content="yes">

    <meta name="view-transition" content="same-origin">
    
    <!-- RSS Feed -->
    <link rel="alternate" type="application/atom+xml" title="Daniël van der Winden" href="/feed.xml">
    {% if env.NODE_ENV == 'production' %}
    <script defer src="https://cloud.umami.is/script.js" data-website-id="5a0a578b-bf79-4578-96ef-373454590774"></script>
    {% endif %}

    <!-- Open Graph meta tags -->
    <meta property="og:title" content="{% if title %}{{ title }} · Daniël van der Winden{% else %}Daniël van der Winden · Software designer & writer{% endif %}">
    <meta property="og:description" content="{{ description or metadata.description }}">
    <meta property="og:url" content="{{ metadata.url }}{{ page.url }}">
    <meta property="og:type" content="{% if page.url == '/' %}website{% else %}article{% endif %}">
    <meta property="og:site_name" content="Daniël van der Winden">
    
    {% if image and image.src %}
    <!-- Use post-specific image if available -->
    {% set imageBasePath = image.src | replace(".avif", "") | replace(".webp", "") | replace(".jpg", "") | replace(".jpeg", "") | replace(".png", "") | replace(".JPG", "") | replace(".PNG", "") %}
    {% set ogImageUrl = metadata.url + imageBasePath + "-1200.webp" %}
    <meta property="og:image" content="{{ ogImageUrl }}">
    <meta property="og:image:alt" content="{{ image.alt or title }}">
    {% else %}
    <!-- Use default share image -->
    <meta property="og:image" content="https://www.daniel.pizza/assets/share-image-1200.jpeg">
    <meta property="og:image:alt" content="Daniël van der Winden">
    {% endif %}
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    
    <!-- Twitter Card meta tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{% if title %}{{ title }} · Daniël van der Winden{% else %}Daniël van der Winden · Software designer & writer{% endif %}">
    <meta name="twitter:description" content="{{ description or metadata.description }}">
    {% if image and image.src %}
    <meta name="twitter:image" content="{{ ogImageUrl }}">
    <meta name="twitter:image:alt" content="{{ image.alt or title }}">
    {% else %}
    <meta name="twitter:image" content="https://www.daniel.pizza/assets/share-image-1200.jpeg">
    <meta name="twitter:image:alt" content="Daniël van der Winden">
    {% endif %}
    <script>
      // Reveal content once fonts are ready (background stays visible during load)
      var reveal = function() { document.documentElement.classList.remove('fonts-loading'); };
      document.fonts.ready.then(reveal);
      setTimeout(reveal, 1000);
    </script>
</head>
<body class="min-h-screen font-sans overflow-x-hidden">
    <!-- Background layer -->
    <div id="page-background" class="fixed inset-0 -z-10 {{ bodyClass }}"></div>

    <!-- Skip navigation for keyboard users -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Content wrapper -->
    <div id="page-content">
    {% include "header.njk" %}

        <nav class="fixed z-50 bottom-4 left-4 right-4 sm:bottom-6 sm:left-6 sm:right-auto" role="navigation" aria-label="Main navigation">
            <div class="relative px-4 py-3 overflow-hidden bg-white border border-gray-200 rounded-lg dark:bg-black dark:border-gray-700 sm:bg-transparent sm:dark:bg-transparent sm:border-0 sm:p-0">
                <div class="absolute inset-y-0 right-0 w-12 pointer-events-none bg-gradient-to-l from-white dark:from-black to-transparent sm:hidden"></div>
                {% include "navigation.njk" %}
            </div>
        </nav>

        <main id="main-content" class="ml-0 lg:ml-80 mr-0 lg:mr-32 pt-20 px-6 lg:px-12 flex-1 flex justify-end max-w-[1600px]" role="main">
            <div class="w-full max-w-[1400px]">
                <div class="w-full max-w-lg ml-auto prose prose-lg font-serif lg:pt-[25vh] pt-[6vh] pb-32 dark:prose-invert">
                    {{ content | safe }}
                    {% if tags %}
                    <ul class="mt-6 font-sans text-sm tracking-wide text-gray-500 dark:text-gray-600 flex flex-wrap items-center gap-x-2 not-prose" style="list-style: none; padding: 0;">
                      {% for tag in tags | sort %}
                      {% set displayTag = tag %}
                      {% if tag == "iOS" %}
                        {% set displayTag = "iOS" %}
                      {% elif tag | lower == "youtube" %}
                        {% set displayTag = "YouTube" %}
                      {% elif tag | lower == "rss" %}
                        {% set displayTag = "RSS" %}
                      {% else %}
                        {% set displayTag = tag | capitalize %}
                      {% endif %}
                      <li class="flex items-center gap-x-2">
                        <a href="/links/{{ tag | slugify }}/" class="text-gray-500 dark:text-gray-600 hover:text-gray-700 dark:hover:text-gray-500" style="text-decoration: none;">{{ displayTag }}</a>
                        {% if not loop.last %}<span aria-hidden="true">·</span>{% endif %}
                      </li>
                      {% endfor %}
                    </ul>
                    {% endif %}
                    <div class="w-full max-w-lg ml-auto prose prose-lg font-serif dark:prose-invert">
                        {% include "footer.njk" %}
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        // Set Last.fm configuration from environment variables
        window.LASTFM_API_KEY = '{{ env.LASTFM_API_KEY | trim }}';
        window.LASTFM_USERNAME = '{{ env.LASTFM_USERNAME | trim }}';
        {% if page.url == '/now/' %}
        // Set Strava data (fetched at build time)
        window.STRAVA_ACCESS_TOKEN = '{{ stravaToken.accessToken }}';
        window.STRAVA_ACTIVITIES = {{ stravaActivities.activityCountByDate | dump | safe }};
        window.STRAVA_LAST_UPDATED = '{{ stravaActivities.lastUpdated }}';
        
        // Set GitHub data
        window.GITHUB_USERNAME = 'dvdwinden';
        window.GITHUB_CONTRIBUTIONS = {{ githubContributions.contributionsByDate | dump | safe }};
        window.GITHUB_LAST_UPDATED = '{{ githubContributions.lastUpdated }}';
        {% endif %}
    </script>
    <script src="/js/dark-mode.js"></script>
    <script src="/js/header-scroll.js"></script>
    <script src="/js/lastfm-live.js"></script>
    {% if page.url == '/now/' %}
    <script src="/js/strava-live.js"></script>
    <script src="/js/github-live.js"></script>
    {% endif %}
</html>
