{#
    Webmentions for the current page.

    Renders nothing at all unless this page has actually been mentioned, and
    only on writing: a post in links/, journal/ or newsletter/. The homepage,
    /photos/ and the other standing pages collect plenty of Bluesky likes by
    way of Bridgy, but a facepile under a page that isn't a piece of writing
    is just noise — those pages stay clean.

    `showWebmentions: true` in a page's frontmatter forces it on anyway, and
    `false` forces it off a post. (Not `webmentions: false` — that name would
    shadow the global data below.)

    Nothing here is piped through `| safe`. All of it was written by strangers;
    src/_data/webmentions.js reduces it to plain text and validated URLs, and
    Nunjucks' autoescaping is the second half of that. Styles live in the
    WEBMENTIONS section of src/css/style.css.
#}
{% macro avatar(author) %}
{#
    The initial is always rendered; the photo, when there is one, sits on top of
    it. A photo that 404s or is blocked removes itself and the initial is
    already there underneath — which is what the fixtures exercise, since their
    author photos point at hosts that don't resolve. Without this an author
    whose avatar has rotted gets a broken-image glyph in the byline.
#}
<span class="webmention-avatar" aria-hidden="true">
    <span class="webmention-avatar-initial">{{ author.initial }}</span>
    {% if author.photo %}
    <img
        class="webmention-avatar-photo"
        src="{{ author.photo }}"
        alt=""
        width="32"
        height="32"
        loading="lazy"
        decoding="async"
        onerror="this.remove()">
    {% endif %}
</span>
{% endmacro %}

{% set wm = webmentions.byUrl[page.url] %}
{# Posts live in these three directories; everything else is a standing page. #}
{% set isPost = page.filePathStem.startsWith("/links/")
    or page.filePathStem.startsWith("/journal/")
    or page.filePathStem.startsWith("/newsletter/") %}
{% set show = isPost %}
{% if showWebmentions == true %}{% set show = true %}{% endif %}
{% if showWebmentions == false %}{% set show = false %}{% endif %}
{% if wm and wm.total and show %}
{% set conversation = wm.replies.concat(wm.mentions) %}
{% set facepile = wm.likes.concat(wm.reposts) %}
{# Capped: the label above already carries the true count, and a popular post
   bridged from Bluesky can collect hundreds of likes — which wrap into a wall
   of discs on a phone long before they tell the reader anything more. #}
{% set faces = facepile.slice(0, 24) %}

<section class="webmentions not-prose" aria-labelledby="webmentions-heading">
    <h2 id="webmentions-heading" class="webmentions-heading">
        Responses
    </h2>

    {% if conversation.length %}
    <ol class="webmentions-list">
        {% for mention in conversation %}
        <li class="webmention">
            <div class="webmention-byline">
                {{ avatar(mention.author) }}

                <span class="webmention-byline-text">
                    <span class="webmention-author" dir="auto">
                        {% if mention.author.url %}
                        <a href="{{ mention.author.url }}" rel="external nofollow noopener" target="_blank">{{ mention.author.name }}</a>
                        {% else %}
                        {{ mention.author.name }}
                        {% endif %}
                    </span>
                    <span class="webmention-meta">
                        {% if mention.property == 'in-reply-to' %}replied{% else %}mentioned this{% endif %}{% if mention.published %} on
                        <time datetime="{{ mention.published }}">{{ mention.publishedDisplay }}</time>{% endif %}
                    </span>
                </span>
            </div>

            {% if mention.title and mention.property != 'in-reply-to' %}
            <p class="webmention-title" dir="auto">
                <a href="{{ mention.source }}" rel="external nofollow noopener" target="_blank">{{ mention.title }}</a>
            </p>
            {% endif %}

            {% if mention.content %}
            <blockquote class="webmention-content" cite="{{ mention.source }}" dir="auto">
                {{ mention.content }}
            </blockquote>
            {% endif %}

            {# The source link is the whole point of a webmention: it's the
               evidence, and it sends the reader to where the reply actually
               lives rather than keeping a copy of it here. #}
            <a class="webmention-source" href="{{ mention.source }}" rel="external nofollow noopener" target="_blank">
                Read in full
                <span aria-hidden="true">→</span>
            </a>
        </li>
        {% endfor %}
    </ol>
    {% endif %}

    {% if facepile.length %}
    <div class="webmention-facepile">
        <h3 class="webmention-facepile-label">
            {{ wm.likes.length }} like{% if wm.likes.length != 1 %}s{% endif %}{% if wm.reposts.length %}
            · {{ wm.reposts.length }} repost{% if wm.reposts.length != 1 %}s{% endif %}{% endif %}
        </h3>
        <ul class="webmention-faces">
            {% for mention in faces %}
            <li>
                {# The link is labelled rather than relying on the image, whose
                   alt is empty: a screen reader announcing forty filenames is
                   worse than announcing forty names. #}
                <a
                    href="{{ mention.author.url or mention.source }}"
                    rel="external nofollow noopener"
                    target="_blank"
                    aria-label="{{ mention.author.name }}{% if mention.property == 'like-of' %} liked{% else %} reposted{% endif %} this"
                    title="{{ mention.author.name }}">
                    {{ avatar(mention.author) }}
                </a>
            </li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}
</section>
{% endif %}
