{#- The og:image / twitter:image tags for the page.

    A page with `image.src` uses that: the pipeline's 1200px rendition of it,
    or the full 2400px one for the composed share-* images. Everything else
    gets the default photo. -#}
{%- set ogImageWidth = 1200 -%}
{%- set ogImageHeight = 630 -%}
{%- if image and image.src -%}
    {%- set imageBasePath = image.src | replace(".avif", "") | replace(".webp", "") | replace(".jpg", "") | replace(".jpeg", "") | replace(".png", "") | replace(".JPG", "") | replace(".PNG", "") -%}
    {%- if image.src.startsWith("/assets/share-") -%}
        {#- The composed grids of covers, drawn at 2400×1260 and kept at that
            size by the pipeline (see HIGH_QUALITY_WEBP_PATHS). -#}
        {%- set ogImageUrl = metadata.url + imageBasePath + "-2400.webp" -%}
        {%- set ogImageWidth = 2400 -%}
        {%- set ogImageHeight = 1260 -%}
    {%- else -%}
        {%- set ogImageUrl = metadata.url + imageBasePath + "-1200.webp" -%}
    {%- endif -%}
    {%- set ogImageAlt = image.alt or title -%}
{%- else -%}
    {%- set ogImageUrl = "https://www.daniel.pizza/assets/share-image-1200.webp?v=2" -%}
    {%- set ogImageAlt = "Daniël van der Winden, reading at a TRANSCRIPT launch" -%}
{%- endif %}
    <meta property="og:image" content="{{ ogImageUrl }}">
    <meta property="og:image:alt" content="{{ ogImageAlt }}">
    <meta property="og:image:width" content="{{ ogImageWidth }}">
    <meta property="og:image:height" content="{{ ogImageHeight }}">
    <meta name="twitter:image" content="{{ ogImageUrl }}">
    <meta name="twitter:image:alt" content="{{ ogImageAlt }}">
