---
permalink: sitemap.xml
eleventyExcludeFromCollections: true
---

<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for page in collections.all %}
  {% if not page.data.draft and page.url %}
  <url>
    <loc>{{ metadata.url }}{{ page.url }}</loc>
    <lastmod>{{ page.date | date("yyyy-MM-dd") }}</lastmod>
    {% if page.url == "/" %}
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
    {% elif page.url == "/now/" %}
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
    {% elif page.url.includes("/journal/") and page.url != "/journal/" %}
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
    {% elif page.url.includes("/links/") and page.url != "/links/" %}
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
    {% elif page.url.includes("/newsletter/") and page.url != "/newsletter/" %}
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
    {% elif page.url == "/journal/" or page.url == "/links/" or page.url == "/newsletter/" %}
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
    {% else %}
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
    {% endif %}
  </url>
  {% endif %}
{% endfor %}
</urlset>

